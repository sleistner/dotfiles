# Interactive aliases and small helper functions — sourced from linked/zshrc.

function gcm() {
  local main
  main=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && main=${main#origin/}
  git checkout "${main:-main}" "$@"
}
alias jq=jaq
alias -- -='cd -'
if [[ $OSTYPE == darwin* ]]; then alias ls='ls -G'; else alias ls='ls --color=auto'; fi
alias l='ls -lah'
alias ll='ls -lh'
alias gst='git status'
alias ggpull='git pull origin "$(git branch --show-current)"'
alias ggpush='git push origin "$(git branch --show-current)"'
alias gcmsg='git commit --message'
alias gc='git commit --verbose'
alias gcp='git cherry-pick'
