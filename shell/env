# vim: set syntax=bash :
#
# Shared shell env — PATH, editor, locale, ulimit.
# Sourced from linked/zshrc on every interactive shell.

export EDITOR=nvim
export LANG=en_US.UTF-8
export GOPATH="$HOME/go"
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"

# Login shells get this from brew shellenv; non-login shells find the installation.
if [[ -z $HOMEBREW_PREFIX ]]; then
  for _brew_prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
    if [[ -x $_brew_prefix/bin/brew ]]; then
      export HOMEBREW_PREFIX=$_brew_prefix
      break
    fi
  done
  unset _brew_prefix
fi

# Auto-dedupe PATH entries (zsh keeps only the first occurrence).
typeset -U path PATH

PATH="/usr/local/bin:/usr/local/sbin:/usr/bin/vendor_perl:$PATH"
PATH="$PATH:$GOPATH/bin"
PATH="$HOME/.bin:$PATH"
PATH="$HOME/.local/bin:$PATH"
for _p in mysql-client openssl@3; do
  [[ -n $HOMEBREW_PREFIX && -d "$HOMEBREW_PREFIX/opt/$_p/bin" ]] &&
    PATH="$HOMEBREW_PREFIX/opt/$_p/bin:$PATH"
done
unset _p
PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"
PATH="$HOME/.cargo/bin:$PATH"
PATH="$HOME/.antigravity/antigravity/bin:$PATH"

export PATH

ulimit -n 4095
