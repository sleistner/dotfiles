# Sourced for every zsh invocation (including non-interactive and scripts).
# Keep this minimal — anything slow belongs in zshrc, not here.

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Give Cursor's noninteractive shells tools without installing interactive hooks.
if [[ -n "$CURSOR_AGENT" ]]; then
  typeset -U path PATH
  path=("${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims" $path)
fi
