#!/usr/bin/env bash
# dotctl theme — flip Ghostty and Herdr between preset themes.
#
# Presets live in themes/<name>.theme (shell variable assignments). Applying
# one writes ~/.config/ghostty/theme.conf (included by the Ghostty config),
# sets Herdr's theme and the herdr-radar selected-row colour, then reloads both.
#
# Usage:
#   dotctl theme [list]     list presets, current one marked
#   dotctl theme <name>     apply a preset
#   dotctl theme next       apply the next preset in the list
#   dotctl theme -h         this help

set -u

BIN_DIR=$(cd "$(dirname "$0")" && pwd -P)
REPO="${DOTFILES_DIR:-$(cd "$BIN_DIR/../.." && pwd -P)}"
THEMES_DIR="$REPO/themes"
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/dotctl/theme"
GHOSTTY_OUT="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/theme.conf"
HERDR_CONFIG="${HERDR_CONFIG_PATH:-$HOME/.config/herdr/config.toml}"
RADAR_ID="hhdebb.herdr-radar"
RADAR_CONFIG="$HOME/.config/herdr/plugins/config/$RADAR_ID/config.toml"

die() {
  printf 'dotctl theme: %s\n' "$1" >&2
  exit 1
}

names() {
  local f
  for f in "$THEMES_DIR"/*.theme; do
    [ -f "$f" ] || continue
    f=${f##*/}
    printf '%s\n' "${f%.theme}"
  done
}

current() { cat "$STATE_FILE" 2>/dev/null || true; }

list() {
  local cur n
  cur=$(current)
  while IFS= read -r n; do
    if [ "$n" = "$cur" ]; then printf '* %s\n' "$n"; else printf '  %s\n' "$n"; fi
  done < <(names)
}

next_name() {
  local cur first="" n take=0
  cur=$(current)
  while IFS= read -r n; do
    [ -z "$first" ] && first=$n
    if [ "$take" = 1 ]; then
      printf '%s\n' "$n"
      return
    fi
    [ "$n" = "$cur" ] && take=1
  done < <(names)
  printf '%s\n' "$first"
}

apply_ghostty() {
  local ghostty_theme=${GHOSTTY_THEME:-}
  [ -n "${GHOSTTY_THEME_LIGHT:-}" ] && ghostty_theme="light:$GHOSTTY_THEME_LIGHT,dark:${GHOSTTY_THEME_DARK:-$GHOSTTY_THEME_LIGHT}"
  mkdir -p "$(dirname "$GHOSTTY_OUT")"
  cat >"$GHOSTTY_OUT" <<CONF
# generated by 'dotctl theme' — do not edit
theme = $ghostty_theme
font-size = $GHOSTTY_FONT_SIZE
minimum-contrast = $GHOSTTY_MIN_CONTRAST
adjust-cell-height = $GHOSTTY_CELL_HEIGHT
font-thicken = $GHOSTTY_THICKEN
CONF
  reload_ghostty
}

# macOS: Cmd+Shift+, in the frontmost Ghostty window (needs Accessibility permission).
reload_ghostty() {
  [ "$(uname -s)" = Darwin ] || return 0
  osascript -e 'tell application "System Events"
    if name of first application process whose frontmost is true is "Ghostty" then keystroke "," using {command down, shift down}
  end tell' >/dev/null 2>&1 || echo "dotctl theme: press Cmd+Shift+, in Ghostty to reload"
}

# Set `key = "value"` under [colors] in the radar config, creating file/table as needed.
set_radar_colors() {
  local row_bg=$1
  mkdir -p "$(dirname "$RADAR_CONFIG")"
  [ -f "$RADAR_CONFIG" ] || printf 'follow_appearance = false\n' >"$RADAR_CONFIG"
  grep -q '^\[colors\]' "$RADAR_CONFIG" || printf '\n[colors]\n' >>"$RADAR_CONFIG"
  local key
  for key in active_row_bg_light active_row_bg_dark; do
    if grep -q "^$key" "$RADAR_CONFIG"; then
      sed -i.bak "s|^$key.*|$key = \"$row_bg\"|" "$RADAR_CONFIG"
    else
      sed -i.bak "/^\[colors\]/a\\
$key = \"$row_bg\"
" "$RADAR_CONFIG"
    fi
  done
  rm -f "$RADAR_CONFIG.bak"
}

# Set `key = value` inside [section] of a TOML file, inserting it when absent.
toml_set() {
  local file=$1 section=$2 key=$3 value=$4 tmp
  tmp=$(mktemp)
  awk -v sec="[$section]" -v key="$key" -v val="$value" '
    $0 == sec { insec = 1; print; next }
    /^\[/ { if (insec && !done) { print key " = " val; done = 1 } insec = 0 }
    insec && $0 ~ "^" key "[ ]*=" { print key " = " val; done = 1; next }
    { print }
    END { if (insec && !done) print key " = " val }
  ' "$file" >"$tmp" && cat "$tmp" >"$file"
  rm -f "$tmp"
}

BLOCK_BEGIN="# >>> dotctl theme block"
BLOCK_END="# <<< dotctl theme block"

drop_block() {
  sed -i.bak "/^$BLOCK_BEGIN/,/^$BLOCK_END/d" "$HERDR_CONFIG"
  rm -f "$HERDR_CONFIG.bak"
}

apply_herdr() {
  command -v herdr >/dev/null 2>&1 || return 0
  [ -f "$HERDR_CONFIG" ] || return 0
  drop_block
  local row_bg
  if [ -n "${HERDR_THEME_LIGHT:-}" ]; then
    row_bg=${HERDR_ROW_BG_DARK:-}
    toml_set "$HERDR_CONFIG" theme name "\"${HERDR_THEME_DARK:-$HERDR_THEME_LIGHT}\""
    toml_set "$HERDR_CONFIG" theme auto_switch true
    toml_set "$HERDR_CONFIG" theme light_name "\"$HERDR_THEME_LIGHT\""
    toml_set "$HERDR_CONFIG" theme dark_name "\"${HERDR_THEME_DARK:-$HERDR_THEME_LIGHT}\""
    printf '\n%s\n[theme.custom.light]\nactive_row_bg = "%s"\n\n[theme.custom.dark]\nactive_row_bg = "%s"\n%s\n' \
      "$BLOCK_BEGIN" "${HERDR_ROW_BG_LIGHT:-}" "${HERDR_ROW_BG_DARK:-}" "$BLOCK_END" >>"$HERDR_CONFIG"
  else
    row_bg=${HERDR_ROW_BG:-}
    toml_set "$HERDR_CONFIG" theme name "\"$HERDR_THEME\""
    toml_set "$HERDR_CONFIG" theme auto_switch false
  fi
  if herdr plugin list 2>/dev/null | grep -q "$RADAR_ID"; then
    set_radar_colors "$row_bg"
    local a
    for a in state-stop configure state-start; do
      herdr plugin action invoke "$RADAR_ID.$a" >/dev/null 2>&1 || true
      sleep 1
    done
  fi
  herdr server reload-config >/dev/null 2>&1 || true
}

case "${1:-}" in
  -h | --help)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  "" | list)
    list
    exit 0
    ;;
  next) name=$(next_name) ;;
  *) name=$1 ;;
esac

[ -n "$name" ] || die "no presets in $THEMES_DIR"
file="$THEMES_DIR/$name.theme"
[ -f "$file" ] || die "unknown preset: $name (try 'dotctl theme')"

# shellcheck source=/dev/null
. "$file"

apply_ghostty
apply_herdr
mkdir -p "$(dirname "$STATE_FILE")"
printf '%s\n' "$name" >"$STATE_FILE"
printf 'theme: %s\n' "$name"
