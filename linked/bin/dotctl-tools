#!/usr/bin/env bash
# Browse TOOLS.md — fuzzy picker, plain text, or machine-readable records.
#
#   dotctl tools [QUERY]      picker; prints the selected command
#   dotctl tools --all        the full reference
#   dotctl tools --info NAME  one tool's entry
#   dotctl tools --json       every tool as JSON
#   dotctl tools -h           this help
#
# The zsh wrapper in zshrc puts the selected command on the next prompt.

set -eu

REPO="${DOTFILES_DIR:-$HOME/config/dotfiles}"
doc="$REPO/TOOLS.md"
self="$0"

# One tab-separated record per tool: section, name, alias, description, aka.
# A row may bold several names ("**pngcrush**, **pngquant**"); each becomes
# its own record sharing the description.
#
# aka collects the backticked tokens out of the description — TOOLS.md writes
# what a tool replaces as `top`, `du`, `nvm`, so those are the names someone
# searches by when they can't recall the new one.
records() {
  awk -F'|' '
    /^## / { section = substr($0, 4); next }
    /^\| \*\*/ {
      cell = $2
      desc = $3
      gsub(/^[ \t]+|[ \t]+$/, "", desc)

      aka = ""
      rest = desc
      while (match(rest, /`[^`]+`/)) {
        aka = aka " " substr(rest, RSTART + 1, RLENGTH - 2)
        rest = substr(rest, RSTART + RLENGTH)
      }

      rem = cell
      while (match(rem, /\*\*[^*]+\*\*/)) {
        name = substr(rem, RSTART + 2, RLENGTH - 4)
        rem = substr(rem, RSTART + RLENGTH)
        tail = rem
        if (match(tail, /\*\*/)) tail = substr(tail, 1, RSTART - 1)
        alias = ""
        if (match(tail, /`[^`]+`/)) alias = substr(tail, RSTART + 1, RLENGTH - 2)
        printf "%s\t%s\t%s\t%s\t%s\n", section, name, alias, desc, aka
      }
    }
  ' "$doc"
}

# mdcat only on a tty; pipes and Raycast get raw markdown.
render() {
  if [ -t 1 ]; then
    mdcat -p -
  else
    cat
  fi
}

show_all() {
  render <"$doc"
}

show_section() {
  awk -v q="$1" '
    /^## / { section=tolower($0); printing = index(section, tolower(q)) > 0 }
    printing
  ' "$doc" | render
}

show_info() {
  records | awk -F'\t' -v want="$1" '
    tolower($2) == tolower(want) || (tolower($3) == tolower(want) && $3 != "") {
      printf "%s", $2
      if ($3 != "") printf "  (%s)", $3
      printf "\n%s\n\n%s\n", $1, $4
      exit
    }
  '
  # tealdeer needs `tldr --update` before it has any pages; stay quiet until then.
  if command -v tldr >/dev/null 2>&1 && page=$(tldr "$1" 2>/dev/null); then
    printf '\n%s\n' "$page"
  fi
}

show_json() {
  records | awk -F'\t' '
    function esc(s,   out, c, i) {
      out = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\"" || c == "\\") out = out "\\" c
        else out = out c
      }
      return out
    }
    BEGIN { print "[" }
    {
      if (n++) print ","
      aka = $5
      gsub(/^[ \t]+|[ \t]+$/, "", aka)
      printf "  {\"name\": \"%s\", \"alias\": \"%s\", \"section\": \"%s\", \"description\": \"%s\", \"aka\": \"%s\"}",
        esc($2), esc($3), esc($1), esc($4), esc(aka)
    }
    END { if (n) print ""; print "]" }
  '
}

# Rank a query against one tool, best band wins:
#   0  the name, whole word          top -> (nothing)
#   1  an alias or a backticked tool  top -> bottom, whose entry says `top`/`htop`
#   2  a word in those starting with the query   moni -> (nothing yet)
#   3  a description word starting with the query   monit -> bottom
# Matching on word starts, not anywhere in the string, is what keeps
# "desktop" and "Start/stop" out of a search for "top". Every term in a
# multi-word query has to match; the weakest band it lands in wins.
search() {
  records | awk -F'\t' -v query="$1" '
    function norm(s) {
      s = tolower(s)
      gsub(/[^a-z0-9@.+]+/, " ", s)
      return " " s " "
    }
    function band(term, name, alias, aka, desc) {
      if (index(name, " " term " ")) return 0
      if (index(alias, " " term " ") || index(aka, " " term " ")) return 1
      if (index(name, " " term) || index(alias, " " term) || index(aka, " " term)) return 2
      if (index(desc, " " term)) return 3
      return -1
    }
    BEGIN { nterms = split(tolower(query), terms, /[ \t]+/) }
    {
      section = $1; name = $2; alias = $3; desc = $4
      nname = norm(name); nalias = norm(alias); naka = norm($5); ndesc = norm(desc)

      rank = 0
      for (i = 1; i <= nterms; i++) {
        if (terms[i] == "") continue
        b = band(terms[i], nname, nalias, naka, ndesc)
        if (b < 0) next
        if (b > rank) rank = b
      }

      label = name
      if (alias != "" && alias != name) label = label " (" alias ")"
      # Field 1 is what you would actually type, so Enter yields a runnable
      # command: bottom hands back btm, ripgrep hands back rg.
      cmd = (alias != "" ? alias : name)
      printf "%d\t%s\t%-30s %s\t · %s\n", rank, cmd, label, desc, section
    }
  ' | LC_ALL=C sort -t"$(printf '\t')" -k1,1n -k2,2 | cut -f2-
}

# fzf does its own fuzzy matching, which for "top" also accepts a scattered
# t..o..p and returns half the file. --disabled turns that off and reloads
# from search() on every keystroke instead.
#
# Prints the selected command. The zsh wrapper in zshrc feeds that to
# `print -z`, which puts it on the next prompt without running it.
pick() {
  local line
  line=$(
    fzf </dev/null \
      --disabled \
      --query="$1" \
      --prompt='tools > ' \
      --header='enter: put on prompt · esc: quit' \
      --bind="start:reload('$self' --search {q})" \
      --bind="change:reload('$self' --search {q})" \
      --delimiter='\t' \
      --with-nth=2,3 \
      --tabstop=1 \
      --preview="'$self' --info {1}" \
      --preview-window='right,50%,wrap' \
      --no-multi
  ) || return 0
  [ -n "$line" ] && printf '%s\n' "${line%%	*}"
}

case "${1:-}" in
  -h | --help)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    printf '\nSections:\n'
    awk '/^## / { sub(/^## /, "  "); print }' "$doc"
    ;;
  --all)
    show_all
    ;;
  --json)
    show_json
    ;;
  --search)
    search "${2:-}"
    ;;
  --pick)
    # The zsh wrapper captures stdout, so -t 1 is false here — it has already
    # established that this is interactive.
    pick "${2:-}"
    ;;
  --info)
    [ $# -ge 2 ] || {
      echo "dotctl tools: --info needs a tool name" >&2
      exit 2
    }
    show_info "$2"
    ;;
  -*)
    printf 'dotctl tools: unknown option: %s\n' "$1" >&2
    exit 2
    ;;
  *)
    if [ -t 1 ] && command -v fzf >/dev/null 2>&1; then
      pick "${1:-}"
    elif [ -n "${1:-}" ]; then
      show_section "$1"
    else
      show_all
    fi
    ;;
esac
