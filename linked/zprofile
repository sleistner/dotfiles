# Sourced once per login shell (before zshrc). Put login-only setup here:
# Homebrew shellenv and any vendor pre/post hooks.

for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x $_brew ]]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew
