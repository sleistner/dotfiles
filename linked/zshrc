# Interactive zsh config — native zsh setup, shell env, shell integrations
# (direnv, mise, fzf, atuin, zoxide, yazi, starship, autosuggestions,
# syntax-highlighting).
# Kept minimal for startup speed (~170ms warm). See README.md § Startup perf.

# ---- shell options, history, completion, keys ----
# Native replacements for what oh-my-zsh used to provide.

setopt auto_cd auto_pushd pushd_ignore_dups pushdminus
setopt always_to_end auto_menu complete_in_word interactive_comments long_list_jobs
unsetopt flowcontrol menu_complete

HISTFILE=${HISTFILE:-$HOME/.zsh_history}
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history share_history hist_expire_dups_first hist_ignore_dups \
  hist_ignore_space hist_verify

# Configure completion paths before compinit.
typeset -U fpath FPATH
fpath=(
  /opt/homebrew/share/zsh/site-functions
  /opt/homebrew/share/zsh-completions
  $fpath
)

# Single compinit; -u/-C skip the security audit (safe on a single-user box);
# the dump is rebuilt at most once a day.
autoload -Uz compinit
_zcompdump=${ZDOTDIR:-$HOME}/.zcompdump
if [[ -n $_zcompdump(#qN.mh+24) ]]; then compinit -u -d "$_zcompdump"; else compinit -C -d "$_zcompdump"; fi
unset _zcompdump
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# Key bindings (emacs mode, plus the common terminal escapes).
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[[1;3D' backward-word
bindkey '^[[Z' reverse-menu-complete

# Run zsh-autosuggestions history scan asynchronously (snappier prompt).
ZSH_AUTOSUGGEST_USE_ASYNC=1
for _zas in /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
            $HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  [[ -r $_zas ]] && { source "$_zas"; break; }
done
unset _zas

# ---- shell env ----

# Resolve the repo from this file's symlink target so any clone location works.
_dotfiles=${${(%):-%x}:A:h:h}
source "$_dotfiles/shell/env"

# ---- shell integrations ----

eval "$(direnv hook zsh)"

# 1Password SSH agent (optional; only takes effect when 1Password is running).
_1p_sock=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
[[ -S "$_1p_sock" ]] && export SSH_AUTH_SOCK="$_1p_sock"
unset _1p_sock

# Mise
eval "$(mise activate zsh)"

# fzf keybindings + completion (ctrl-T files, alt-C dirs; ctrl-R is atuin below)
# stderr redirect silences a harmless `can't change option: zle` from fzf's
# option-restore loop in non-TTY contexts — keybindings still register.
FZF_CTRL_R_COMMAND='' source <(fzf --zsh) 2>/dev/null

# atuin — sqlite-backed shell history (binds ctrl-R; overrides fzf's).
# --disable-up-arrow keeps plain ↑ for prefix-search via zsh history.
eval "$(atuin init zsh --disable-up-arrow)"

# zoxide — smart cd (`z <partial-path>` jumps to frecent dirs)
eval "$(zoxide init zsh)"

# yazi — TUI file manager. `y` wrapper cd's the shell to yazi's last dir.
function y() {
  local tmp="$(mktemp -t yazi-cwd.XXXXXX)" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

# dotctl tools — picker hands back a command; `print -z` puts it on the next
# prompt, unrun, so you can add arguments. Anything else goes straight through.
function dotctl() {
  if [[ "$1" == tools && "$2" != -* && -t 1 ]]; then
    local cmd
    cmd=$(command dotctl tools --pick "$2") || return
    [[ -n "$cmd" ]] && print -z -- "$cmd"
  else
    command dotctl "$@"
  fi
}

# Starship
eval "$(starship init zsh)"

# Aliases and git helpers
source "$_dotfiles/shell/aliases"
unset _dotfiles

# zsh-syntax-highlighting — MUST be near the end, after all other widgets.
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

